# Copie ce fichier sous le nom .env, puis adapte les valeurs.
# Ne publie jamais le fichier .env : il contient ta clé secrète.

# Option 1 : Groq, gratuit, en ligne (clé sur console.groq.com/keys)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=ta_cle_groq
LLM_MODEL=openai/gpt-oss-20b

